---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../site.config';

const base = import.meta.env.BASE_URL;
const linkedIn = siteConfig.social.find((item) => item.label === 'LinkedIn')!;

const invitations = [
  {
    number: '01',
    audience: 'Teachers',
    title: 'Tell me about your classroom.',
    description:
      'If you teach, you know things about how children learn that no amount of reading will give me. I would like to hear what works, what wastes your time, and what you wish someone would ask you.',
    action: 'Write to me',
    subject: 'From a teacher'
  },
  {
    number: '02',
    audience: 'School leaders & educators',
    title: 'Show me where I’m naive.',
    description:
      'People who have actually run schools see the constraints that convictions tend to ignore. If something on this site strikes you as wishful, I would rather hear it now than learn it later.',
    action: 'Set me straight',
    subject: 'A view from inside schools'
  },
  {
    number: '03',
    audience: 'Parents & everyone else',
    title: 'What did school do for you?',
    description:
      'Parents, former students, anyone who cares about school education. Stories about the moment a subject opened up, or closed down, are the ones I find most useful.',
    action: 'Share your story',
    subject: 'About school education'
  }
];
---
<BaseLayout
  title="Contact"
  description="An open invitation to teachers, school leaders, parents, and anyone who cares about school education and how children are taught."
  className="page-main"
>
  <div class="shell">
    <header class="page-heading">
      <p class="eyebrow">Contact</p>
      <h1>I’d rather talk<br /><em>than broadcast.</em></h1>
      <p class="lede">
        This site sets out what I believe. The more useful half of the conversation is the part where
        someone who knows more than I do tells me where it breaks.
      </p>
    </header>

    <div class="connect-grid">
      {invitations.map((item) => (
        <article class="connect-card">
          <div class="connect-topline"><span>{item.audience}</span><span>{item.number}</span></div>
          <h2>{item.title}</h2>
          <p>{item.description}</p>
          <a class="text-link" href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(item.subject)}`}>
            {item.action}<span aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>

    <section class="education-connections" aria-labelledby="contact-direct-title">
      <div class="connect-heading">
        <h2 id="contact-direct-title">Or simply<br /><em>send an email.</em></h2>
        <p>
          No form, no newsletter, nothing to sign up for. I read everything that arrives and reply to
          what I can.
        </p>
      </div>
      <div class="hero-actions">
        <a class="button-link" href={`mailto:${siteConfig.email}`}>{siteConfig.email} <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={linkedIn.href} target="_blank" rel="me noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-footnote"><span class="fine-rule" aria-hidden="true"></span> If you are curious how I got here, <a href={`${base}my-story/`}>my story</a> is the longer version.</div>
    </section>
  </div>
</BaseLayout>
