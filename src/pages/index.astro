---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import PublicationCard from '../components/PublicationCard.astro';
import publications from '../data/publications.json';
import news from '../data/news.json';
import { siteConfig } from '../site.config';

const base = import.meta.env.BASE_URL;
const recentPublications = [...publications]
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title))
  .slice(0, 2);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: 'Scientific Software Engineer and Numerical Methods Researcher',
  affiliation: siteConfig.affiliations.map((item) => ({
    '@type': 'Organization',
    name: item.name,
    url: item.href
  })),
  email: `mailto:${siteConfig.email}`,
  sameAs: siteConfig.social
    .filter((item) => item.href.startsWith('http'))
    .map((item) => item.href)
};
---

<BaseLayout
  title="Pardeep Kumar"
  description="Scientific software engineering, numerical methods, and high-performance computing by Pardeep Kumar."
  className="home-main"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Scientific computing · Software engineering · Numerical methods</p>
      <h1>Pardeep Kumar</h1>
      <p class="hero-tagline">
        I turn mathematical and physical models into dependable, high-performance software.
      </p>
      <p class="hero-lede">
        Hello, I’m Pardeep, a scientific software engineer and numerical methods
        researcher based in Amsterdam. I work where mathematical models, engineering
        applications, and reliable computation meet.
      </p>
      <p class="hero-supporting">
        I have more than ten years of experience across research, energy,
        semiconductors, CAE, finance, and computational physics. My doctoral thesis,
        developed at CWI Amsterdam and TU Delft, has been submitted. I am now looking
        for software roles where numerical depth and sound engineering both matter.
      </p>
      <div class="hero-actions">
        <a class="button-link" href={`${base}software/`}>Software experience</a>
        <a class="text-link hero-secondary-link" href={`${base}web/`}>Web applications →</a>
        <a class="text-link hero-secondary-link" href={`${base}research/`}>Research →</a>
      </div>
      <SocialLinks />
    </div>

    <figure class="profile-figure">
      <div class="portrait-frame">
        <img
          src={`${base}images/profile.jpg`}
          width="3072"
          height="4096"
          alt="Pardeep Kumar outdoors"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>Scientific computing</span>
        <span>Software engineering</span>
      </figcaption>
    </figure>
  </section>

  <section class="section-block tinted-section about-home">
    <div class="shell about-home-grid">
      <div>
        <p class="eyebrow">About me</p>
        <h2>My path has never belonged to just one field.</h2>
      </div>

      <div class="about-home-copy">
        <p>
          I trained in aerospace engineering at IIT Bombay and began my career building
          simulation software in India. Since then, I have worked across automotive
          engineering, semiconductors, finance, and energy before returning to research
          in the Netherlands.
        </p>
        <p>
          The subjects have changed, but the work I enjoy has remained surprisingly
          consistent: learning an unfamiliar domain, finding the structure inside a
          messy problem, and turning that understanding into software that other people
          can use and trust.
        </p>
        <p>
          My doctoral research gave me the opportunity to study scientific questions
          in depth, particularly how complex fluids behave during transport. It also
          strengthened the way I build software: formulate the problem carefully,
          expose assumptions, measure performance, and validate results before trusting
          them.
        </p>
        <ul class="about-interest-list" aria-label="Current interests">
          <li>Scientific computing</li>
          <li>Numerical methods</li>
          <li>High-performance computing</li>
          <li>Software architecture</li>
          <li>Independent web products</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section-block tinted-section explore-section">
    <div class="shell">
      <div class="section-heading-row explore-heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2>Explore</h2>
        </div>
        <p>
          Review my software experience, follow the mathematics, or browse the
          peer-reviewed work behind the models.
        </p>
      </div>

      <div class="explore-grid">
        <a class="explore-card" href={`${base}software/`}>
          <span>01</span>
          <h3>Software</h3>
          <p>Ten years of scientific software, simulation, HPC, and engineering applications.</p>
          <strong>View software experience →</strong>
        </a>
        <a class="explore-card" href={`${base}research/`}>
          <span>02</span>
          <h3>Research</h3>
          <p>Numerical methods for constrained, multiphysics, and multiscale systems.</p>
          <strong>Read the overview →</strong>
        </a>
        <a class="explore-card" href={`${base}publications/`}>
          <span>03</span>
          <h3>Publications</h3>
          <p>Peer-reviewed work on phase equilibrium and CO₂-rich multiphase transport.</p>
          <strong>Browse the papers →</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="section-block shell research-intro">
    <div>
      <p class="eyebrow">What I do</p>
      <h2>Turning complex physical models into dependable computation</h2>
    </div>
    <div class="research-intro-copy">
      <p>
        I study how equation formulation, numerical variables, and discretisation
        choices affect robustness, accuracy, efficiency, and physical consistency.
      </p>
      <ul>
        <li>Multiphase thermodynamics and UVN-flash calculations</li>
        <li>CO₂-rich transient tank and pipeline transport</li>
        <li>Computational electromagnetics and numerical relativity</li>
        <li>High-performance and AI-assisted scientific software</li>
      </ul>
      <a class="text-link" href={`${base}research/`}>More about my research →</a>
    </div>
  </section>

  <section class="section-block tinted-section">
    <div class="shell section-heading-row">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Recent publications</h2>
      </div>
      <a class="text-link" href={`${base}publications/`}>All publications →</a>
    </div>
    <div class="shell publication-list home-publications">
      {recentPublications.map((publication) => (
        <PublicationCard publication={publication} concise />
      ))}
    </div>
  </section>

  <section class="section-block shell news-layout">
    <div>
      <p class="eyebrow">Updates</p>
      <h2>What’s new</h2>
    </div>
    <ol class="news-list">
      {news.map((item) => (
        <li>
          <time datetime={item.date}>{item.date}</time>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-block tinted-section off-clock-section">
    <div class="shell off-clock-grid">
      <p class="eyebrow">Away from the screen</p>
      <p>
        Life is not all equations and code. I enjoy playing ping-pong, experimenting
        with Indian recipes in the kitchen, and learning about Indian philosophy. I am
        still exploring these traditions, and I value the different questions they ask
        about knowledge, action, and how to live well.
      </p>
    </div>
  </section>

  <section class="section-block shell contact-band">
    <div>
      <p class="eyebrow">Let’s talk</p>
      <h2>Scientific software or an interesting computational problem?</h2>
    </div>
    <div>
      <p>
        I welcome conversations about numerical methods, scientific computing,
        engineering software, high-performance systems, and research collaborations.
      </p>
      <a class="button-link" href={`mailto:${siteConfig.email}`}>Email me</a>
    </div>
  </section>
</BaseLayout>
