---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
import publications from '../data/publications.json';
import news from '../data/news.json';
import { siteConfig } from '../site.config';

const base = import.meta.env.BASE_URL;
const recentPublications = [...publications]
  .sort((a, b) => b.year - a.year || a.title.localeCompare(b.title))
  .slice(0, 2);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteConfig.name,
  jobTitle: 'Researcher in Numerical Methods and Scientific Computing',
  affiliation: siteConfig.affiliations.map((item) => ({
    '@type': 'Organization',
    name: item.name,
    url: item.href
  })),
  email: `mailto:${siteConfig.email}`,
  sameAs: siteConfig.social
    .filter((item) => item.href.startsWith('http'))
    .map((item) => item.href)
};
---

<BaseLayout
  title="Pardeep Kumar"
  description="Numerical methods, scientific software, and web applications by Pardeep Kumar at CWI Amsterdam and TU Delft."
  className="home-main"
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>

  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">Scientific computing · CWI Amsterdam · TU Delft</p>
      <h1>Pardeep Kumar</h1>
      <p class="hero-tagline">
        Numerical methods, scientific software, and useful web products.
      </p>
      <p class="hero-lede">
        I am a researcher and software developer working where mathematical models
        meet reliable computation. My research spans multiphase thermodynamics,
        finite-volume methods, CO₂ transport, electromagnetics, and numerical relativity.
      </p>
      <p class="hero-supporting">
        I also design full-stack products—from a civic strategy game and a transparent
        news platform to real-time chess and a research project workspace.
      </p>
      <div class="hero-actions">
        <a class="button-link" href={`${base}projects/`}>Explore my work</a>
        <a class="text-link hero-secondary-link" href={`${base}cv/`}>Read my CV →</a>
      </div>
      <SocialLinks />
    </div>

    <figure class="profile-figure">
      <div class="portrait-frame">
        <img
          src={`${base}images/profile.jpg`}
          width="3072"
          height="4096"
          alt="Pardeep Kumar outdoors"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <figcaption>
        <span>Researcher</span>
        <span>Scientific software developer</span>
      </figcaption>
    </figure>
  </section>

  <section class="section-block featured-projects-section">
    <div class="shell section-heading-row">
      <div>
        <p class="eyebrow">Built from first principles</p>
        <h2>Selected web projects</h2>
      </div>
      <a class="text-link" href={`${base}projects/`}>See project details →</a>
    </div>
    <div class="shell project-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="section-block tinted-section explore-section">
    <div class="shell">
      <div class="section-heading-row explore-heading">
        <div>
          <p class="eyebrow">Start here</p>
          <h2>Explore</h2>
        </div>
        <p>
          Follow the mathematics, browse the published work, or read the longer
          explanations behind the models and software.
        </p>
      </div>

      <div class="explore-grid">
        <a class="explore-card" href={`${base}research/`}>
          <span>01</span>
          <h3>Research</h3>
          <p>Numerical methods for constrained, multiphysics, and multiscale systems.</p>
          <strong>Read the overview →</strong>
        </a>
        <a class="explore-card" href={`${base}publications/`}>
          <span>02</span>
          <h3>Publications</h3>
          <p>Peer-reviewed work on phase equilibrium and CO₂-rich multiphase transport.</p>
          <strong>Browse the papers →</strong>
        </a>
        <a class="explore-card" href={`${base}blog/`}>
          <span>03</span>
          <h3>Research notes</h3>
          <p>Plain-language derivations, numerical experiments, and evolving technical ideas.</p>
          <strong>Open the notes →</strong>
        </a>
      </div>
    </div>
  </section>

  <section class="section-block shell research-intro">
    <div>
      <p class="eyebrow">What I do</p>
      <h2>Turning complex physical models into dependable computation</h2>
    </div>
    <div class="research-intro-copy">
      <p>
        I study how equation formulation, numerical variables, and discretisation
        choices affect robustness, accuracy, efficiency, and physical consistency.
      </p>
      <ul>
        <li>Multiphase thermodynamics and UVN-flash calculations</li>
        <li>CO₂-rich transient tank and pipeline transport</li>
        <li>Computational electromagnetics and numerical relativity</li>
        <li>High-performance and AI-assisted scientific software</li>
      </ul>
      <a class="text-link" href={`${base}research/`}>More about my research →</a>
    </div>
  </section>

  <section class="section-block tinted-section">
    <div class="shell section-heading-row">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2>Recent publications</h2>
      </div>
      <a class="text-link" href={`${base}publications/`}>All publications →</a>
    </div>
    <div class="shell publication-list home-publications">
      {recentPublications.map((publication) => (
        <PublicationCard publication={publication} concise />
      ))}
    </div>
  </section>

  <section class="section-block shell news-layout">
    <div>
      <p class="eyebrow">Updates</p>
      <h2>What’s new</h2>
    </div>
    <ol class="news-list">
      {news.map((item) => (
        <li>
          <time datetime={item.date}>{item.date}</time>
          <p>{item.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="section-block tinted-section off-clock-section">
    <div class="shell off-clock-grid">
      <p class="eyebrow">Away from the screen</p>
      <p>
        Outside research and programming, I enjoy playing ping-pong and cricket—two
        good reminders that timing, placement, and adapting to the next move matter.
      </p>
    </div>
  </section>

  <section class="section-block shell contact-band">
    <div>
      <p class="eyebrow">Let’s talk</p>
      <h2>Research, software, or an interesting problem?</h2>
    </div>
    <div>
      <p>
        I welcome conversations about numerical methods, scientific computing,
        full-stack products, and research collaborations.
      </p>
      <a class="button-link" href={`mailto:${siteConfig.email}`}>Email me</a>
    </div>
  </section>
</BaseLayout>
