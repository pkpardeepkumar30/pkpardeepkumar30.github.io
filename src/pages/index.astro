---
import { Image } from 'astro:assets';
import portrait from '../../public/images/me1.jpg';
import BaseLayout from '../layouts/BaseLayout.astro';
import ConnectCards from '../components/ConnectCards.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout className="home-main">
  <section class="founder-hero shell" aria-labelledby="hero-title">
    <div class="founder-intro">
      <p class="eyebrow"><span class="status-dot" aria-hidden="true"></span> Education founder · Engineer · Builder</p>
      <h1 id="hero-title">Better education.<br />Stronger futures.<br /><em>Built together.</em></h1>
      <p class="founder-lede">I’m Pardeep Kumar. I’m building a school in India, bringing an engineer’s discipline and a lifelong curiosity about learning to education.</p>
      <div class="hero-actions">
        <a class="button-link" href={`${base}education/`}>Explore my education focus <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#connect">Let’s connect <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero-footnote"><span class="fine-rule" aria-hidden="true"></span> Open to conversations with investors, educators &amp; partners.</div>
    </div>
    <figure class="founder-portrait">
      <div class="portrait-window">
        <Image src={portrait} alt="Pardeep Kumar" widths={[480, 800, 1200]} sizes="(max-width: 800px) 90vw, 40vw" width={900} format="webp" loading="eager" fetchpriority="high" />
        <span class="portrait-index" aria-hidden="true">A NEW CHAPTER / EDUCATION</span>
      </div>
      <figcaption><span><strong>Pardeep Kumar</strong><br />Building with purpose.</span><span class="portrait-sign" aria-hidden="true">PK</span></figcaption>
    </figure>
  </section>
  <section class="background-strip" aria-label="Background at a glance">
    <div class="shell background-strip-inner">
      <p>A foundation in<br /><strong>ideas &amp; execution</strong></p>
      <div><strong>10+ years</strong><span>Engineering &amp; research</span></div>
      <div><strong>IIT Bombay</strong><span>Aerospace engineering</span></div>
      <div><strong>CWI / TU Delft</strong><span>Doctoral research</span></div>
      <div><strong>India ↔ Europe</strong><span>A cross-border perspective</span></div>
    </div>
  </section>
  <section class="section-block shell chapter-grid" aria-labelledby="education-title">
    <div class="section-label"><span>01 / THE NEXT CHAPTER</span><span class="section-line"></span></div>
    <div class="chapter-copy">
      <p class="eyebrow">Building in education</p>
      <h2 id="education-title">A good school starts<br />with <em>good people.</em></h2>
      <p>My focus is on building a school in India where strong teaching, curiosity, and real understanding shape the student experience.</p>
      <p>I’m interested in meeting people who share that ambition: investors with a long-term interest in Indian education, experienced education partners, and excellent teachers who care deeply about their craft.</p>
      <a class="text-link" href={`${base}education/`}>The thinking behind the school <span aria-hidden="true">↗</span></a>
    </div>
    <aside class="belief-card">
      <span class="belief-symbol" aria-hidden="true">↗</span>
      <p class="eyebrow">The starting point</p>
      <p class="belief-statement">Great teachers.<br />Curious minds.<br />Lasting possibilities.</p>
      <p>A commitment to the people and the everyday work that make education matter.</p>
    </aside>
  </section>
  <section class="founder-background section-block" aria-labelledby="background-title">
    <div class="shell">
      <div class="section-label"><span>02 / THE PERSON BEHIND THE WORK</span><span class="section-line"></span></div>
      <div class="background-grid">
        <div><p class="eyebrow">From engineering to education</p><h2 id="background-title">A builder’s mindset.<br /><em>A wider ambition.</em></h2><a class="text-link" href={`${base}about/`}>More about me <span aria-hidden="true">↗</span></a></div>
        <div class="background-copy"><p>I trained in aerospace engineering at IIT Bombay and spent more than a decade working across software, engineering, and research in India and the Netherlands.</p><p>My experience includes Shell, ASM International, and doctoral research at CWI Amsterdam and TU Delft. Along the way, I’ve built scientific software and independent digital products, taking ideas through to working systems.</p><p>That experience shapes how I approach education: ask good questions, bring capable people together, and put care into execution.</p></div>
      </div>
      <div class="work-links">
        <a href={`${base}web/`}><span>Product building</span><strong>Ideas made real</strong><span aria-hidden="true">↗</span></a>
        <a href={`${base}research/`}><span>Research &amp; engineering</span><strong>A foundation in rigour</strong><span aria-hidden="true">↗</span></a>
        <a href={`${base}blog/`}><span>Writing</span><strong>Thinking out loud</strong><span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>
  <section class="section-block shell connect-section" id="connect" aria-labelledby="connect-title">
    <div class="section-label"><span>03 / LET’S CONNECT</span><span class="section-line"></span></div>
    <div class="connect-heading"><h2 id="connect-title">The right conversation<br />can be <em>a beginning.</em></h2><p>I’m open to meeting people who want to invest in education in India, help build a thoughtful school, or join as exceptional teachers.</p></div>
    <ConnectCards />
  </section>
</BaseLayout>
