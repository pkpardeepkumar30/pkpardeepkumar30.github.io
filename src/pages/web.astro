---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Independent ventures"
  description="Independent web applications by Pardeep Kumar, including The Republic, Nazar India, Chess Duel, and WorkAtlas."
  className="page-main"
>
  <div class="shell">
    <header class="page-heading projects-heading">
      <p class="eyebrow">Ideas into practice</p>
      <h1>Independent ventures</h1>
      <p class="lede">
        Products I have independently designed, built, and launched. Each explores
        a different way to make information, learning, or collaboration more useful.
      </p>
      <div class="hero-actions">
        <a class="text-link" href={`${base}about/`}>
          The person behind the products ↗
        </a>
      </div>
    </header>

    <div class="project-grid project-grid-detailed">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</BaseLayout>
