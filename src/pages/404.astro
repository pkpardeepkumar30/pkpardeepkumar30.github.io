---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found" description="The requested page could not be found." className="page-main">
  <div class="shell empty-state not-found">
    <p class="eyebrow">404</p>
    <h1>That page is not here.</h1>
    <p>The address may have changed, or the page may not have been published yet.</p>
    <a class="button-link" href={base}>Return home</a>
  </div>
</BaseLayout>
