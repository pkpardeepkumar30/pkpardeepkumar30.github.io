---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';
---

<BaseLayout
  title="Web projects"
  description="Selected web applications by Pardeep Kumar: civic simulation, transparent news, online chess, and research project management."
  className="page-main"
>
  <div class="shell">
    <header class="page-heading projects-heading">
      <p class="eyebrow">Selected software</p>
      <h1>Web projects</h1>
      <p class="lede">
        Four products exploring civic systems, trustworthy information, real-time
        interaction, and practical organization. Each one started with a different
        problem and called for a different technical architecture.
      </p>
    </header>

    <div class="project-grid project-grid-detailed">
      {projects.map((project) => <ProjectCard project={project} detailed />)}
    </div>
  </div>
</BaseLayout>
