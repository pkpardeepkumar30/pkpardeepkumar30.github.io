---
import { siteConfig } from '../site.config';
const connections = [
  { number: '01', audience: 'Investors', title: 'Invest in education.', description: 'Interested in investing in education in India? Let’s discuss the school, the ambition, and whether our long-term interests align.', action: 'Start a conversation', subject: 'Education in India : investor conversation' },
  { number: '02', audience: 'Teachers', title: 'Help young minds grow.', description: 'I’m looking to hire high-quality teachers who bring subject depth, clarity, and genuine care for students. I’d love to hear from you.', action: 'Introduce yourself', subject: 'Teaching at the school : introduction' },
  { number: '03', audience: 'Education partners', title: 'Bring your perspective.', description: 'School leaders, educators, and people with experience building strong learning environments: let’s explore what we could do together.', action: 'Explore a connection', subject: 'Education partnership : introduction' }
];
---
<div class="connect-grid">
  {connections.map((item) => <article class="connect-card">
    <div class="connect-topline"><span>{item.audience}</span><span>{item.number}</span></div>
    <h3>{item.title}</h3><p>{item.description}</p>
    <a class="text-link" href={`mailto:${siteConfig.email}?subject=${encodeURIComponent(item.subject)}`}>{item.action}<span aria-hidden="true">↗</span></a>
  </article>)}
</div>
