---
import { siteConfig } from '../site.config';
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const linkedIn = siteConfig.social.find(item => item.label === 'LinkedIn')!;
---
<footer class="site-footer">
  <div class="shell footer-top">
    <div><a class="footer-name" href={base}>{siteConfig.name}<span>.</span></a><p>Building with purpose.<br />Education. Enterprise. Possibility.</p></div>
    <div class="footer-link-group"><span>Explore</span><a href={`${base}education/`}>Education</a><a href={`${base}about/`}>About</a><a href={`${base}web/`}>Ventures</a></div>
    <div class="footer-link-group"><span>Ideas &amp; background</span><a href={`${base}blog/`}>Writing</a><a href={`${base}research/`}>Research</a><a href={`${base}publications/`}>Publications</a></div>
    <div class="footer-link-group"><span>Start a conversation</span><a href={`mailto:${siteConfig.email}`}>Email me ↗</a><a href={linkedIn.href} target="_blank" rel="noreferrer">LinkedIn ↗</a></div>
  </div>
  <div class="shell footer-inner"><p>© {year} {siteConfig.name}</p><p>Built on curiosity. Looking ahead.</p></div>
</footer>
